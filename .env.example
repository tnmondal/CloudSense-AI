# CloudSense AI — Environment Configuration Example
# Copy this file to `.env` and fill in real values locally. Never commit a
# real `.env` file, API key, or service-account credential to version control.

# ---------------------------------------------------------------------------
# Gemini FinOps Copilot (optional — omit to run in deterministic/offline mode)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
CLOUDSENSE_AI_GEMINI_MODEL=gemini-2.0-flash
CLOUDSENSE_AI_MOCK_MODE=false

# ---------------------------------------------------------------------------
# Phase 6 — BigQuery data backend (optional, additive; default is "local")
# ---------------------------------------------------------------------------
# Leave these unset/empty to run entirely in local mode (the default and
# currently the ONLY backend the running API actually uses). These settings
# are only consumed by run_bigquery_migration.py in this phase.
CLOUDSENSE_DATA_BACKEND=local
CLOUDSENSE_GCP_PROJECT_ID=
CLOUDSENSE_BIGQUERY_DATASET=cloudsense_dw

# Authentication for BigQuery uses standard Google Application Default
# Credentials (ADC) — either run `gcloud auth application-default login`,
# or point GOOGLE_APPLICATION_CREDENTIALS at a service-account key file you
# manage OUTSIDE this repository. Never place a credential file inside this
# project directory.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/this/repo/key.json
